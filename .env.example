# Copy to .env. The backend reads it; the browser never sees these values.
# Foundry project endpoint (Foundry portal > project overview).
FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
FOUNDRY_AGENT_NAME=olist-agent
# Optional: pin a reviewed agent version. Leave unset to use the latest version.
FOUNDRY_AGENT_VERSION=
FOUNDRY_TIMEOUT_S=60
# Foundry agents use Microsoft Entra ID, not API keys. Locally, run `az login`.
# In a container without Azure CLI, use a service principal or managed identity, e.g.:
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# Caller protection. Production requires azure_container_apps or shared_login (docs/cloud.md).
APP_ENV=local
AUTH_MODE=local
# AUTH_MODE=shared_login only: one credential pair handed to a demo audience. Set these in
# the container app's settings, never in the repository. Each browser that signs in gets
# its own conversation history.
SHARED_LOGIN_USERNAME=
SHARED_LOGIN_PASSWORD=
# Signs session cookies. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Unset means a new secret per process, so sign-ins end on restart.
SESSION_SECRET=
SESSION_HOURS=12
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
MAX_REQUEST_BYTES=65536
MAX_CONCURRENT_REQUESTS=4

# Optional: read-only sandbox warehouse checks in scripts/ (standard libpq names).
PGHOST=your-server.postgres.database.azure.com
PGPORT=5432
PGDATABASE=olist_olap_abd
PGUSER=your-read-only-role
PGPASSWORD=
PGSSLMODE=verify-full
