# Keep your existing .env. The backend reads it; the frontend never reads secrets.
PGHOST=your-server.postgres.database.azure.com
PGPORT=5432
PGDATABASE=olist_olap_abd
PGUSER=your-read-only-role
PGPASSWORD=
PGSSLMODE=verify-full
PGSSLROOTCERT=system
OPENROUTER_API_KEY=
OPENAI_MODEL=openai/gpt-4.1-nano
OPENAI_PROVIDER=openrouter
# Direct OpenAI alternative: provider=openai, model=gpt-4.1-nano, OPEN_AI_API_KEY=...
# Optional Azure migration: provider=azure; model must be the deployment name.
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=
# Leave Azure key empty to use DefaultAzureCredential (install the azure extra).
# PG_AUTH_MODE=entra
# PGUSER=your-managed-identity-database-role
APP_ENV=local
AUTH_MODE=local
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DB_POOL_MAX_SIZE=4
QUERY_TIMEOUT_MS=8000
MAX_CONCURRENT_REQUESTS=4
# Local Markdown audit; cloud containers use stdout and a mounted audit path if needed.
AUDIT_LOG_PATH=logs/db_operations.md
# APPLICATIONINSIGHTS_CONNECTION_STRING=
